# Every VITE_* value is baked into the public bundle at build time. Nothing here is secret.

# Backend origin for /api. Leave EMPTY in production: nginx proxies /api/ to the chat server on
# the same origin. Set it only for a static host with no proxy, e.g. https://chat.squidlor.com
VITE_API_BASE=

# Reown (WalletConnect) project id. Public by design; the domain allowlist in the Reown dashboard
# is the control. Unset = the WalletConnect option is hidden and injected + Coinbase still work.
VITE_WC_PROJECT_ID=

# Base RPCs the page reads receipts and balances through, comma-separated, tried in order.
VITE_BASE_RPC_URLS=https://base-rpc.publicnode.com,https://mainnet.base.org

# Sister surfaces the page links to.
VITE_CHAT_URL=https://chat.squidlor.com
VITE_MARKETS_URL=https://markets.squidlor.com
